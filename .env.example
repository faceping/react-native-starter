# Your FacePing sandbox key: https://app.faceping.ai/signup, then Developers, Sandbox keys, Create sandbox key.
# Copy this file to .env.local (ignored by git) and replace the placeholder. Expo reads it when it bundles the app.
EXPO_PUBLIC_FACEPING_SANDBOX_KEY=fp_test_…

# To run as a check-in device for your practice list instead (see "Try it as a check-in device" in the README), set
# the device token from the list's Devices tab and the personId you enrolled on the list. A token wins over the key.
# EXPO_PUBLIC_FACEPING_DEVICE_TOKEN=fpd_…
# EXPO_PUBLIC_FACEPING_PERSON_ID=ACME-000123
